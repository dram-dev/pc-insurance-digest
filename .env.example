# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────
DB_PATH=./data/state.db

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Reddit (OPTIONAL — default ingestor uses the Atom RSS feed, no auth) ──
# Endpoint reality (2026): Reddit 403s the unauthenticated /top.json endpoint
# even from residential IPs, and OAuth (PRAW) needs Responsible-Builder approval
# that personal-use scripts increasingly can't get. The .rss feed is still
# served, so RSS is the default mode and needs no credentials at all.
# Trade-off: RSS carries no score/comment counts, so subreddits.yaml's
# min_score / min_comments are inert on the RSS path (top/.rss pre-sorts by top).
#
# REDDIT_MODE: rss (default) | json (legacy, currently 403s). Ignored if PRAW on.
REDDIT_MODE=rss
# A descriptive User-Agent naming your account avoids edge blocks.
REDDIT_USER_AGENT=pc-insurance-digest/0.1 by u/your_username

# PRAW (only if you obtain OAuth approval): set true and fill the two keys.
# Create app: https://www.reddit.com/prefs/apps → "script" type.
REDDIT_USE_PRAW=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── SEC EDGAR (free, user-agent required) ─────────────────
# SEC requires a real name + email in the user agent string
EDGAR_USER_AGENT=Your Name your.email@example.com

# ════════════════════════════════════════════════════════════════════════
# LOCAL LLM MODELS — upgrade here (plug-and-play, no code changes)
# ════════════════════════════════════════════════════════════════════════
# Every stage routes through the pluggable backend registry. To move to a newer
# model: change the stage's *_BACKEND / *_MODEL below, pull/restart the new
# model, then run `uv run digest models` to confirm it's reachable BEFORE a run.
# Backends: claude_cli_pro · haiku_api · gemini_flash_free · local_qwen (Ollama)
# · mlx_local (MLX server).

# ── Summarizer (long-form notes + regime judgment) ──
# Default mlx_local talks to the MLX server at MLX_SERVER_URL (uses MLX_MODEL).
#   haiku_api      = Anthropic Haiku, requires ANTHROPIC_API_KEY
#   gemini_flash_free = Google Gemini Flash free tier, requires GEMINI_API_KEY
#   claude_cli_pro = your Claude Pro plan via `claude -p` (uses SUMMARIZER_MODEL)
SUMMARIZER_BACKEND=mlx_local
SUMMARIZER_MODEL=mlx-community/Qwen3.5-27B-4bit   # claude_cli_pro/weekly model
SUMMARIZER_MAX_PER_RUN=50
SUMMARIZER_MAX_PER_SOURCE=12
SUMMARIZER_TIMEOUT_SEC=120

# Optional API keys for the cloud summarizer backends
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Triage (keep/drop + topic) — also routes through the backend registry ──
# Default local_qwen (Ollama, uses OLLAMA_MODEL). Set TRIAGE_BACKEND=mlx_local
# to triage on the MLX server (MLX_MODEL) instead. `ollama pull <model>` once.
TRIAGE_BACKEND=local_qwen
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
TRIAGE_MAX_TOKENS=384
TRIAGE_MIN_SCORE=0.5
TRIAGE_LOOKBACK_HOURS=24

# ── Embeddings (semantic layer: related / ask) — Ollama only ──
# `ollama pull nomic-embed-text` once (digest models flags it if missing).
EMBEDDING_MODEL=nomic-embed-text

# ── MLX-LM server (Apple Silicon, shared with macro digest) ───────────────
# Macro digest's com.dr.mlx.server launchd job keeps this running.
MLX_SERVER_URL=http://localhost:8080
MLX_MODEL=mlx-community/Qwen3.5-27B-4bit

# ── Obsidian (shared vault with macro digest) ─────────────────────────────
# Vault path is your top-level Obsidian vault. Within it, pc-insurance-digest
# writes to OBSIDIAN_DIGEST_DIR ("81 P&C Digest" by default — Johnny Decimal
# alongside macro digest's "80 Digest").
OBSIDIAN_VAULT_PATH=/Users/dramsey/Library/Mobile Documents/iCloud~md~obsidian/Documents/Vault
OBSIDIAN_DIGEST_DIR=81 P&C Digest

# ── HN threshold ─────────────────────────────────────────
HN_MIN_POINTS=100

# ── Alpha engine — insurer return forecasts (uv sync --extra ml) ──────────
# Tiingo free EOD price API (https://www.tiingo.com) — the reliable price source
# for `digest forecast prices`. Yahoo 429s and Stooq challenges unauthenticated
# traffic, so set a token for dependable backfills. Empty → best-effort Yahoo/Stooq.
TIINGO_API_TOKEN=

# ── Databricks medallion sink (shared-catalog lakehouse) ──────────────────
# Best-effort writes to a Databricks lakehouse alongside SQLite (SQLite stays
# source of truth). All writes no-op when DATABRICKS_ENABLED=false. Shared
# catalog `digest`, schemas prefixed per domain — pc_* here, macro_* in
# macro-ai-digest. Apply packages/digest-core/sql/databricks/{bronze,silver,gold}.sql.
DATABRICKS_ENABLED=false
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=digest
DATABRICKS_SCHEMA_PREFIX=pc_
