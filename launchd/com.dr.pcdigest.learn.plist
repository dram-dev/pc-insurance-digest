<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dr.pcdigest.learn</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>--extra</string>
        <string>ml</string>
        <string>digest</string>
        <string>learn-loop</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- /usr/sbin needed so joblib/sklearn can find `sysctl` for the CPU-core
             count (otherwise it warns + dumps a benign traceback to stderr). -->
        <key>PATH</key>
        <string>/Users/dramsey/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Local-only training job; the alpha-engine warehouse tables aren't
             provisioned, so keep the best-effort sink off to avoid connect
             latency/hangs. Remove once bronze.prices/silver.return_forecasts exist. -->
        <key>DATABRICKS_ENABLED</key>
        <string>false</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>6</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__PROJECT_PATH__/logs/learn.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_PATH__/logs/learn.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
