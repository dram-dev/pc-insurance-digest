<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dr.pcdigest.notify</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>digest</string>
        <string>notify</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/dramsey/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/usr/sbin:/sbin:/bin</string>
    </dict>

    <!-- Delivers the daily run's Telegram alerts once quiet hours end
         (NOTIFY_QUIET_END_HOUR, default 08). The 01:00 run lands inside quiet
         hours, so without this nothing would ever push. No LLM calls. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__PROJECT_PATH__/logs/notify.out.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_PATH__/logs/notify.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
