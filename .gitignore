# Environment
.env
.venv/
venv/

# Secrets (but keep the README)
secrets/*
!secrets/README.md
*.json
!config/*.json
!.mcp.json

# Data
data/
*.db
*.db-journal

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp

# Logs
logs/

# Claude Code files. Ignore session cruft + local settings (via .claude/*, which
# lets git descend), but keep the version-controlled, durable project assets:
# custom commands, subagents, and skills.
.claude/*
!.claude/commands/
!.claude/agents/
!.claude/skills/

# OS
.DS_Store
Thumbs.db
